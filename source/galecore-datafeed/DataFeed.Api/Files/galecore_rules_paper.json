{
  "_meta": {
    "inherits": "galecore_rules_core.json",
    "version": "1.4.0",
    "profile": "paper",
    "status": "paper_only",
    "enabled_for_live": false,
    "last_updated": "2026-07-23",
    "description": "Overlay paper v1.4.0 (PCS-only). Evalua el edge con friccion simulada y mas observabilidad: slippage de entrada mas permisivo y logs de decision/fill. Gatillo de defensa igual al core (0.30). Overridea solo paths de objeto (el DeepMerge reemplaza arrays enteros, por eso no toca position_builder.layers)."
  },
  "execution": {
    "avoid_first_minutes_open": 20,
    "avoid_last_minutes_close": 20,
    "slippage": {
      "new_entries": {
        "max_total_cost_pct_of_expected_credit": 0.12
      }
    }
  },
  "trade_management": {
    "daily_kill_switch": {
      "daily_portfolio_mtm_loss_pct_net_liq_max": 0.015,
      "action": "block_new_entries_for_rest_of_session"
    },
    "hard_defense": {
      "trigger_any": {
        "short_leg_delta_abs_gt": 0.30,
        "unrealized_loss_pct_of_initial_credit_gte": 2.0
      },
      "action": "evaluate_immediate_risk_reduction"
    }
  },
  "monitoring": {
    "review_frequency_minutes": 30,
    "store_intraday_decision_log": true,
    "store_fill_simulation_details": true
  }
}
