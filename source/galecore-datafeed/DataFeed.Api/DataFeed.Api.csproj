<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>129a9ead-8af9-443d-87fd-2c4529063094</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- QUIEN FIJA EL PISO DE VERSIONES (medido el 2026-08-12, no adivinado):
         ModelContextProtocol.AspNetCore 1.2.0 exige Microsoft.Extensions.Hosting.Abstractions y
         Caching.Abstractions >= 10.0.5 INCLUSO en su grupo net8.0, y de ahi NuGet arrastra toda la
         familia de *.Abstractions + Options + Primitives a 10.0.5. Desde la 1.0.0 del paquete MCP no
         hay forma de quedarse en 8.x; la ultima que lo permite es 0.4.0-preview.1.
         Consecuencia practica: NO pinear Microsoft.Extensions.* por debajo de eso. Un
         PackageReference es un MINIMO, asi que el pin no baja nada — solo logra que el mismo assembly
         resuelva 8.0.x en las class libraries y 10.0.5 en la app, que es la version partida que se
         quiere evitar. El criterio es UNA version por assembly en toda la solucion, no "todo en 8.x".
         Los paquetes de ASP.NET Core si van todos en el mismo patch de 8.0.x, la linea del
         TargetFramework: hasta 2026-08-12 SignalR.Protocols.NewtonsoftJson estaba en 10.0.6 y
         Configuration.Json en 10.0.5 sin que nada lo pidiera. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.NewtonsoftJson" Version="8.0.17" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <!-- Alinea Microsoft.IdentityModel.* en una sola version, y NO se puede sacar: AutoMapper (15.1.3
         en DataFeed.Infrastructure) depende de Microsoft.IdentityModel.JsonWebTokens 8.14.0, mientras
         JwtBearer 8.0.17 arrastra Protocols/Protocols.OpenIdConnect 7.1.2. Con la familia partida, el
         recuperador de OIDC (7.x) arma la configuracion y el validador (8.x) la lee vacia:
         GetConfigurationAsync devuelve CERO claves SIN lanzar excepcion y todo JWT valido termina en
         401 "IDX10500: no security keys were provided". No lo arregla ninguna opcion de JwtBearer.
         OJO: hasta 2026-08-12 este comentario culpaba a los paquetes de .NET 10, que ni siquiera
         dependen de IdentityModel. El mecanismo estaba bien diagnosticado; el culpable, no. -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.14.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataFeed.Application\DataFeed.Application.csproj" />
    <ProjectReference Include="..\DataFeed.Infrastructure\DataFeed.Infrastructure.csproj" />
    <ProjectReference Include="..\DataFeed.Repositories\DataFeed.Repositories.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ** recursivo: los archivos por estrategia viven en subcarpetas (Files\Rpf\...). Con un glob
         de un solo nivel compilan pero no se copian al output, y falla recién en runtime. -->
    <Content Update="Files\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
